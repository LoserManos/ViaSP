# Token da API Olho Vivo (SPTrans). NUNCA commitar o .env real.
SPTRANS_TOKEN=
SPTRANS_BASE_URL=https://api.olhovivo.sptrans.com.br/v2.1
SPTRANS_TIMEOUT_SEGUNDOS=10

# Configuração do totem / ponto onde ele está instalado
TOTEM_IDENTIFICADOR=totem-001
PARADA_CODIGO=440016921

# GTFS da SPTrans (pasta ou .zip com stops.txt). Baixe na área do desenvolvedor da SPTrans;
# não vai para o git. Dá nome e coordenadas da parada e alimenta o mapa do modo dev.
GTFS_CAMINHO=data/gtfs

# SQLite local (configuração e logs de uso)
BANCO_CAMINHO=data/totem.db

# Origens permitidas do frontend React (formato JSON)
CORS_ORIGENS=["http://localhost:5173"]
